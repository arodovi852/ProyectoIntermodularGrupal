# ============================================================================
# PLAYTHEMOOD - BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# Este archivo contiene todas las variables de entorno necesarias para el backend.
# Copia este archivo como .env y rellena con tus valores reales.
#
# IMPORTANTE:
# - NO commitear el archivo .env al repositorio
# - Generar nuevos secretos para producción
# - Mantener este archivo actualizado cuando se agreguen nuevas variables
# ============================================================================

# ============================================================================
# 🗄️ DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection URI
# -----------------------
# Formato para MongoDB Atlas (Cloud):
#   mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
#
# Formato para MongoDB Local:
#   mongodb://localhost:27017/database-name
#
# Obtén tu cluster gratis en: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/mood-playlist-app

# ============================================================================
# 🚀 SERVER CONFIGURATION
# ============================================================================

# Puerto en el que escuchará el servidor backend
# Por defecto: 3000
# En producción, usa el puerto proporcionado por tu hosting (ej: Railway, Heroku)
PORT=3000

# Entorno de ejecución
# Valores permitidos: development | production | test
# - development: Muestra logs detallados, stack traces, etc.
# - production: Optimizado para rendimiento, oculta detalles de errores
# - test: Para ejecución de tests automatizados
NODE_ENV=development

# ============================================================================
# 🌐 CORS & FRONTEND CONFIGURATION
# ============================================================================

# URL del frontend para configuración de CORS
# -----------------------
# DESARROLLO:
#   http://localhost:5173  (Vite default)
#   http://localhost:3000  (Create React App / Next.js)
#
# PRODUCCIÓN:
#   https://tu-dominio-frontend.com
#   https://playthemood.vercel.app
#
# IMPORTANTE: Debe coincidir exactamente con la URL de tu frontend
# No incluir slash (/) al final
FRONTEND_URL=http://localhost:5173

# ============================================================================
# 🔐 JWT (JSON Web Token) CONFIGURATION
# ============================================================================

# Secreto para firmar los tokens JWT
# -----------------------
# GENERAR UN SECRETO SEGURO:
#   Opción 1: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Opción 2: openssl rand -hex 32
#   Opción 3: Usar un generador online (ej: https://randomkeygen.com/)
#
# IMPORTANTE:
# - Debe ser una cadena larga y aleatoria (mínimo 32 caracteres)
# - NUNCA usar el mismo secreto en desarrollo y producción
# - Si cambias este valor, todos los tokens existentes serán invalidados
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Tiempo de expiración de los tokens JWT
# -----------------------
# Formatos aceptados:
#   60, "2 days", "10h", "7d", "1y"
#   60 = 60 segundos
#   "7d" = 7 días (recomendado para producción)
#   "1h" = 1 hora (recomendado para desarrollo/testing)
#   "30d" = 30 días (para "recordar sesión")
#
# Recomendación: 7d para balance entre seguridad y experiencia de usuario
JWT_EXPIRES_IN=7d

# ============================================================================
# 🎵 SPOTIFY API CONFIGURATION
# ============================================================================

# Credenciales de la API de Spotify
# -----------------------
# OBTENER CREDENCIALES:
# 1. Ve a https://developer.spotify.com/dashboard
# 2. Inicia sesión con tu cuenta de Spotify
# 3. Clic en "Create an App"
# 4. Rellena los datos de tu aplicación:
#    - App Name: PlayTheMood
#    - App Description: Mood-based playlist generator
#    - Redirect URI: http://localhost:3000/callback (desarrollo)
#                    https://tu-dominio.com/callback (producción)
# 5. Acepta los términos y crea la app
# 6. Copia el Client ID y Client Secret
#
# IMPORTANTE:
# - Regenerar Client Secret en producción
# - No compartir estas credenciales públicamente
# - En producción, configurar Redirect URIs correctas

# ID del cliente de Spotify
# Ejemplo: ea9f4b5bec294856a7ab0f7313e24850
SPOTIFY_CLIENT_ID=your-spotify-client-id-here

# Secreto del cliente de Spotify
# Ejemplo: cb374c7025314476a36e2c6dbec0dc9e
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

# ============================================================================
# 📊 LOGGING & MONITORING (Opcional)
# ============================================================================

# Nivel de logging
# Valores: error | warn | info | http | verbose | debug | silly
# LOG_LEVEL=info

# Habilitar logs en archivo
# ENABLE_FILE_LOGGING=false

# ============================================================================
# 🔧 ADVANCED CONFIGURATION (Opcional)
# ============================================================================

# Tamaño máximo de payload (requests)
# MAX_PAYLOAD_SIZE=10mb

# Timeout para requests (en ms)
# REQUEST_TIMEOUT=30000

# Rate limiting - Peticiones por ventana de tiempo
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# 📝 NOTAS ADICIONALES
# ============================================================================
#
# DESARROLLO LOCAL:
# - Usa MongoDB local o un cluster de Atlas gratuito
# - FRONTEND_URL debe ser http://localhost:5173 (Vite)
# - NODE_ENV=development
#
# PRODUCCIÓN:
# - Usa MongoDB Atlas con autenticación
# - Regenera JWT_SECRET con valor aleatorio fuerte
# - FRONTEND_URL debe ser tu dominio real (https://)
# - NODE_ENV=production
# - Regenera Spotify Client Secret
#
# SEGURIDAD:
# - NUNCA commitear el archivo .env
# - Usar variables de entorno del hosting (Railway, Vercel, Heroku, etc.)
# - Rotar secretos periódicamente
# - Usar diferentes credenciales para cada entorno
#
# ============================================================================

