# ============================================================================
# PLAYTHEMOOD - FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# Este archivo contiene todas las variables de entorno necesarias para el frontend.
# Copia este archivo como .env y rellena con tus valores reales.
#
# IMPORTANTE PARA VITE:
# - Todas las variables DEBEN empezar con VITE_ para ser expuestas al cliente
# - Las variables sin VITE_ NO estarán disponibles en el código
# - Después de cambiar .env, reinicia el servidor de desarrollo
# ============================================================================

# ============================================================================
# 🌐 BACKEND API CONFIGURATION
# ============================================================================

# URL completa del backend API
# -----------------------
# DESARROLLO:
#   http://localhost:3000       (Backend en puerto 3000)
#   http://localhost:5000       (Backend en puerto 5000)
#
# PRODUCCIÓN:
#   https://api.playthemood.com
#   https://playthemood-api.railway.app
#   https://tu-backend.onrender.com
#
# IMPORTANTE:
# - NO incluir /api al final, se añade automáticamente en el código
# - Debe incluir el protocolo (http:// o https://)
# - En producción, usar HTTPS (https://)
# - No incluir slash (/) al final
VITE_BACKEND_URL=http://localhost:3000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Entorno de la aplicación
# Valores permitidos: development | production | staging
# -----------------------
# - development: Modo desarrollo con hot reload, devtools, etc.
# - production: Modo producción optimizado
# - staging: Entorno de pruebas pre-producción
#
# Nota: Vite usa import.meta.env.MODE por defecto, esta variable es opcional
# VITE_NODE_ENV=development

# ============================================================================
# FEATURE FLAGS (Opcional)
# ============================================================================

# Habilitar funcionalidades experimentales
# VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Habilitar modo debug
# VITE_DEBUG_MODE=false

# Habilitar MSW (Mock Service Worker) para testing
# VITE_ENABLE_MSW=false

# ============================================================================
# ANALYTICS & TRACKING (Opcional)
# ============================================================================

# Google Analytics Measurement ID
# Formato: G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=

# Sentry DSN para error tracking
# VITE_SENTRY_DSN=

# ============================================================================
# EXTERNAL SERVICES (Opcional)
# ============================================================================

# CDN URL para assets estáticos
# VITE_CDN_URL=

# URL de la documentación/ayuda
# VITE_DOCS_URL=https://docs.playthemood.com

# ============================================================================
# NOTAS ADICIONALES
# ============================================================================
#
# DESARROLLO LOCAL:
# - VITE_BACKEND_URL=http://localhost:3000
# - Asegúrate de que el backend esté corriendo en el puerto especificado
# - Vite corre por defecto en http://localhost:5173
#
# PRODUCCIÓN:
# - VITE_BACKEND_URL debe apuntar a tu API de producción
# - Usar HTTPS (https://) en producción
# - Configurar CORS correctamente en el backend
#
# VITE ESPECÍFICO:
# - Las variables se acceden con: import.meta.env.VITE_VARIABLE_NAME
# - Las variables se reemplazan en tiempo de BUILD, no en runtime
# - Para cambios en .env, debes reiniciar el dev server
#
# SEGURIDAD:
# - NUNCA expongas secretos o API keys sensibles con VITE_
# - Todo lo que empiece con VITE_ será visible en el bundle final del cliente
# - Para secretos, usa el backend como proxy
#
# EJEMPLO DE USO EN CÓDIGO:
# ```javascript
# const apiUrl = import.meta.env.VITE_BACKEND_URL;
# const isDev = import.meta.env.DEV; // true en desarrollo
# const isProd = import.meta.env.PROD; // true en producción
# ```
#
# ============================================================================

